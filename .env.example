# ── Security ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string
DB_PATH=fht.db

# ── Flight data (AeroDataBox via RapidAPI — free dev tier) ─────────────────
# Leave blank to use the simulated gateway (no API key needed in dev)
# Get a free key: https://rapidapi.com/aedbx-aedbx-default/api/aerodatabox
AERODATABOX_API_KEY=

# ── Email notifications (Gmail SMTP — 100% free) ───────────────────────────
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: Account → Security → App Passwords → generate a 16-char password
# 3. Fill in below — no other cost, up to ~500 emails/day free
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Telegram notifications (100% free, no approval needed) ────────────────
# 1. Message @BotFather on Telegram
# 2. Send /newbot and follow prompts → copy the TOKEN
# 3. Users start a chat with your bot to get their chat_id
#    then link via POST /auth/link-telegram
TELEGRAM_BOT_TOKEN=

# ── Role auto-assignment from email domain ─────────────────────────────────
# Format: domain:ROLE,domain:ROLE
# PLATFORM_ADMIN is never auto-assigned — use /admin/users/{id}/role
DOMAIN_ROLE_HINTS=atc.gov:DESK_STAFF,dgca.gov.in:DESK_STAFF,aai.aero:DESK_STAFF
